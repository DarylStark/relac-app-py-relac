{
    // Python unit testing
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": [
        "--no-cov",
        "tests",
    ],
    "chat.tools.terminal.autoApprove": {
        "uv": true,
        "/^python -m http\\.server 8765$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "pushd": true,
        "popd": true,
        "/^python - <<'PY'\nfrom pathlib import Path\nprint\\(Path\\('src/relac_theme_default/templates/_breadcrumbs\\.html'\\)\\.read_text\\(\\)\\)\nprint\\(Path\\('src/relac_theme_default/templates/_base\\.html'\\)\\.read_text\\(\\)\\[:2500\\]\\)\nPY$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "relac": true,
        "./.venv/bin/python": true
    }
}