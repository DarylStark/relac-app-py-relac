{
    // Python unit testing
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": [
        "--no-cov",
        "tests",
    ],
    "chat.tools.terminal.autoApprove": {
        "uv": true,
        "/^python -m http\\.server 8765$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "pushd": true,
        "popd": true,
        "/^python - <<'PY'\nfrom pathlib import Path\nprint\\(Path\\('src/relac_theme_default/templates/_breadcrumbs\\.html'\\)\\.read_text\\(\\)\\)\nprint\\(Path\\('src/relac_theme_default/templates/_base\\.html'\\)\\.read_text\\(\\)\\[:2500\\]\\)\nPY$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "relac": true,
        "./.venv/bin/python": true,
        "./.venv/bin/ruff": true,
        "/^python3 -m http\\.server 8766 --directory /workspaces/relac-app-py-relac$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^python -m pytest -q tests/test_cli_static_html\\.py -k work_edition_credits_render_in_table_and_detail$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "command": true,
        "./.venv/bin/pytest": true,
        "ty": true,
        "/^python -m http\\.server 8765 --directory out$/": {
            "approve": true,
            "matchCommandLine": true
        }
    }
}